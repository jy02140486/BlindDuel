{
  "id": "prologue_prop_and_follow",
  "durationMs": 8000,
  "tracks": [
    {
      "id": "camera.cutscene",
      "kind": "camera",
      "binding": { "cameraId": "scripted" },
      "channel": "frame",
      "clips": [
        { "type": "setCameraFrame", "atMs": 2000, "center": [-1.2, 2, 0], "height": 4.5, "orthoWidth": 26 },
        { "type": "cameraBlend", "startMs": 2000, "durationMs": 1000, "to": "scripted" },
        { "type": "setCameraFrame", "atMs": 4100, "center": [-1, -1, 0], "height": 1, "orthoWidth": 20 },
        { "type": "cameraBlend", "startMs": 4100, "durationMs": 400, "to": "scripted" },
        { "type": "setCameraFollow", "atMs": 4500, "actorId": "prop_faller", "offsetX": 0, "offsetY": 0, "offsetZ": 0, "lerp": 0.12, "height": 1, "orthoWidth": 20 },
         { "type": "setCameraFollow", "atMs": 5500, "actorId": "enemy_1", "offsetX": 0, "offsetY": 0, "offsetZ": 0, "lerp": 0.12, "height": 1, "orthoWidth": 20 }
      ]
    },
    {
      "id": "camera.back",
      "kind": "camera",
      "binding": { "cameraId": "explore" },
      "channel": "blend",
      "clips": [
        { "type": "cameraBlend", "startMs": 7000, "durationMs": 1000, "to": "explore" }
      ]
    },
    {
      "id": "prop_faller.lifecycle",
      "kind": "actor",
      "binding": { "actorId": "prop_faller" },
      "channel": "command",
      "clips": [
        { "type": "command", "atMs": 500, "command": "idle" },
        { "type": "command", "atMs": 4100, "command": "fall" },
        { "type": "moveActorTo", "startMs": 4100, "durationMs": 400, "x": 0.52, "y": -1.2, "speed": 4 },
        { "type": "command", "atMs": 4500, "command": "land" },
        { "type": "playAudio", "atMs": 4500, "id": "on_land", "volume": 0.8, "pitch": 1.0, "bus": "sfx" },
        { "type": "command", "atMs": 5000, "command": "run" },
        { "type": "moveActorTo", "startMs": 5000, "durationMs": 2900, "x": 25, "y": 0, "speed": 4 },
        { "type": "callback", "atMs": 7900, "fn": "disposeProp", "actorId": "prop_faller" }
      ]
    },
    {
      "id": "companion.bubble_show",
      "kind": "callback",
      "binding": { "actorId": "companion" },
      "clips": [
        { "type": "dialogueBubble", "atMs": 800, "actorId": "companion", "text": "!" }
      ]
    },
    {
      "id": "companion.bubble_wait",
      "kind": "wait",
      "clips": [
        { "type": "wait", "atMs": 800, "durationMs": 2000 }
      ]
    },
    {
      "id": "companion.bubble_hide",
      "kind": "callback",
      "clips": [
        { "type": "dialogueBubble", "atMs": 2500, "action": "hide" }
      ]
    },
    {
      "id": "companion.follow",
      "kind": "callback",
      "clips": [
        { "type": "callback", "atMs": 7400, "fn": "enterCompanionFollowing" }
      ]
    },
    {
      "id": "fx.letterbox",
      "kind": "camera",
      "channel": "fx",
      "clips": [
        { "type": "cameraEffect", "atMs": 0, "effect": "letterbox", "durationMs": 7800, "height": 72, "speed": 240 }
      ]
    },{
      "id": "hero.attention",
      "kind": "actor",
      "binding": { "actorId": "hero" },
      "channel": "movement",
      "clips": [
        { "type": "inputLock", "atMs": 0, "locked": true },
        { "type": "command", "atMs": 200, "command": "walk" },
        { "type": "faceWorldX", "atMs": 100, "direction": 1 },
        { "type": "moveActorByDirection", "startMs": 200, "durationMs": 500,"dir": [1, 0]},
        { "type": "inputLock", "atMs": 8000, "locked": false }
      ]
    },
    {
      "id": "companion.attention",
      "kind": "actor",
      "binding": { "actorId": "companion" },
      "channel": "movement",
      "clips": [
          { "type": "command", "atMs": 0, "command": "walk" },
           { "type": "faceWorldX", "atMs": 100, "direction": 1 },
           { "type": "moveActorTo", "startMs": 0, "durationMs": 500, "x": -23.2, "y": 0.4, "speed": 1.4 },
            { "type": "callback", "atMs": 600, "fn": "enterCompanionIdle" }
      ]
    },
    {
      "id": "enemy_1.in_position",
      "kind": "actor",
      "binding": { "actorId": "enemy_1" },
      "channel": "movement",
      "clips": [
          { "type": "command", "atMs": 6000, "command": "move" },
           { "type": "moveActorTo", "startMs": 6000, "durationMs": 1000, "x": 0.7, "y": -0.4, "speed": 1.4 }
      ]
    }
  ]
}