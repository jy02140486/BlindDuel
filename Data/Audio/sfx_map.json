{
    "footstep": {
        "mode": "surface",
        "fallback": "footstep",
        "bySurface": {
            "hard": { "audioId": "footstep_hard", "volume": 0.8 }
        }
    },
    "swing_light":    { "audioId": "swing_light" },
    "footstep_wood":  { "audioId": "footstep_wood" },
    "footstep_rabble": { "audioId": "footstep_rabble" },
    "duvet_rustle":   { "audioId": "duvet_rustle" },
    "body_collapse":  { "audioId": "body_collapse" },
    "die_collapse":   { "audioId": "die_collapse" },
    "swing_sword_light": { "audioId": "swing_sword_light" },
    "swing_heavy":    { "audioId": "swing_heavy" },
    "swing_thrust":   { "audioId": "swing_thrust" },
    "on_cloaked":     { "audioId": "on_cloaked" },
    "off_cloaked":    { "audioId": "off_cloaked" },
    "on_draw_sheath": { "audioId": "on_draw_sheath" },

    "combat_impact": {
        "mode": "impact",
        "fallbacks": {
            "body_hit":           "combat_body_hit_default",
            "weapon_clash":       "combat_weapon_clash_default",
            "shield_block":       "combat_shield_block_default",
            "shield_broken":      "combat_shield_break_default",
            "projectile_cut":     "combat_weapon_clash_default",
            "projectile_deflect": "combat_weapon_clash_default",
            "projectile_hit":     "combat_body_hit_default"
        },
        "rules": [
            { "when": { "interaction": "body_hit", "sourceMaterial": "blunt", "impactClass": "heavy" }, "audioId": "combat_body_hit_blunt" },
            { "when": { "interaction": "body_hit", "sourceMaterial": "sharp", "impactClass": "heavy" }, "audioId": "combat_sharp_hit_heavy" },
             { "when": { "interaction": "body_hit", "sourceMaterial": "blunt", "impactClass": "light" }, "audioId": "combat_body_hit_blunt" },
            { "when": { "interaction": "body_hit", "sourceMaterial": "sharp", "impactClass": "light" }, "audioId": "combat_sharp_hit_light" },
            { "when": { "interaction": "weapon_clash", "sourceMaterial": "blunt" }, "audioId": "combat_wood_clash" },
            { "when": { "interaction": "weapon_clash", "targetSurface": "blunt" }, "audioId": "combat_wood_clash" }
        ]
    }
}
